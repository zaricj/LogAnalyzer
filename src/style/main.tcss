WelcomeMessage {
    margin: 1 4;
}

AppOutput {
    display: none;
    height: 15;   
    border: tall #0a4ca8;
    margin-top: 2;
}

ConfigurationArea {
    background: $boost;
    padding: 1 2;
    margin: 1 4;
}

HorizontalGroup {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    align: left middle;
}

Label {
    width: 25;
    margin-right: 2;
    padding: 1; 
}

Input {
    width: 1fr;
    min-width: 10;
    max-width: 85;
    background: $boost;
}

Select {
    width: 1fr;
    min-width: 10;
    max-width: 85;
}

Button {
    width: auto;
    height: 3;
    margin-left: 2;
}

#Btn_start_task, #Btn_browse_folder {
    background: #0a4ca8;
    border: tall #0a4ca8 50%;
}

#Btn_start_task:disabled, #Btn_browse_folder:disabled {
    color: #555555;
    opacity: 0.6;
}

#Chk_excel_conversion {
    border: tall #237d2a 50%;
}