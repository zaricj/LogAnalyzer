SystemStats {
    height: 7;
    margin: 1 4;
    padding: 0 1;
    background: $boost;
    border: hkey $accent;
    layout: vertical;
}

#stats_header {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#stats_row {
    width: 100%;
    height: 5;
    align: left middle;
}

StatPanel {
    width: 1fr;
    height: 100%;
    padding: 0 2;
    content-align: left middle;
}

.stats_divider {
    width: 1;
    height: 100%;
    color: $accent 40%;
    content-align: center middle;
}

AppOutputContainer {
    height: 20;
    background: $boost;
    padding: 1 2;
    margin: 1 4;
}

#main_log {
    background: $boost;
}

ConfigurationContainer, TaskRunContainer {
    background: $boost;
    padding: 1 2;
    margin: 1 4;
}

SavedTasksContainer {
    background: $boost;
    padding: 1 2;
    margin: 1 4;
}

OutputHorizontal {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    align: left middle;
}

HorizontalGroup {
    height: auto;
    width: 100%;
    margin-bottom: 1;
    align: left middle;
}

Label {
    width: 25;
    margin-right: 2;
    padding: 1; 
}

Input {
    width: 1fr;
    min-width: 10;
    max-width: 85;
    background: $boost;
}

Select {
    width: 1fr;
    min-width: 10;
    max-width: 85;
}

Button {
    width: auto;
    height: 3;
    margin-left: 2;
}

#Btn_save_task {
    margin-left: 2;
}

#Btn_start_task:disabled, #Btn_browse_folder:disabled {
    color: #555555;
    opacity: 0.6;
}

#Chk_excel_conversion {
    border: tall #237d2a 50%;
    margin-left: 2;
}